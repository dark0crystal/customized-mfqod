# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md
!README.md
docs/

# Docker files (don't copy into containers)
docker-compose*.yml
Dockerfile*
.dockerignore

# Environment files
.env
.env.*
*.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Storage (uploads and offline map tiles - mounted as volumes at runtime)
storage/

# Temporary files
*.tmp
*.bak
*.cache

# Large directories that shouldn't be in build context
backend/logs/
frontend/node_modules/
frontend/dist/
# Offline map tiles are served from the ./storage/map volume, never baked into the image
frontend/public/map/
**/*.pmtiles
# Frontend env files (the image is configured at runtime, see frontend/docker-entrypoint.sh)
frontend/.env
frontend/.env.*
# Playwright e2e package (own node_modules, browsers, reports)
frontend/e2e/

