# =============================================================================
# Frontend configuration (Vite + React Router SPA)
# =============================================================================
# The app reads its settings at RUNTIME from /config.js (window.__APP_CONFIG__):
#   - npm run dev / npm run preview: edit public/config.js
#   - Docker: set environment variables on the container. docker-entrypoint.sh writes
#     /config.js at start-up, so the same image works with any backend and needs no rebuild:
#       API_URL                  Backend URL as seen by the BROWSER (NEXT_PUBLIC_HOST_NAME is
#                                still accepted as an alias)
#       MAP_TILES_URL            /map/oman.pmtiles (default) or an XYZ template .../{z}/{x}/{y}.png
#       MAP_TILES_TYPE           pmtiles | xyz | none
#       MAP_ATTRIBUTION          Map attribution text
#       SHOW_EXTERNAL_MAP_LINKS  true | false (Google Maps buttons; keep false when air-gapped)
#       CSP_EXTRA_CONNECT_SRC    Extra Content-Security-Policy connect-src origins (optional)
#       CSP_EXTRA_IMG_SRC        Extra Content-Security-Policy img-src origins (optional)
#
# This file is for the OPTIONAL build-time fallbacks. They are used only for keys that
# config.js does not set. Copy it to .env.local (Vite loads it automatically, never commit it):
#   cp env.example .env.local
# Only variables that start with VITE_ reach the browser code.
# =============================================================================

# Backend API base URL (auth, items, branches, ...).
# - Local development: http://localhost:8000
# - Production: the backend address the users' browsers can reach, e.g. http://mfqod-api.intranet:8000
VITE_API_URL=http://localhost:8000

# Offline map tiles (see scripts/download-map-tiles.sh)
# VITE_MAP_TILES_URL=/map/oman.pmtiles
# VITE_MAP_TILES_TYPE=pmtiles
# VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors · Protomaps
# VITE_SHOW_EXTERNAL_MAP_LINKS=false
