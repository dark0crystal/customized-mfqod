DATABASE_URL=postgresql://mfqoduser:42287@host.docker.internal:5432/mfqod
# this is the ldap server configuration
AD_SERVER=172.30.22.28
AD_PORT=389
AD_USE_SSL=false	
AD_USE_TLS=false
# LDAP Bind Credentials
AD_BIND_USER=cn=admin,dc=squ,dc=edu,dc=om
AD_BIND_PASSWORD=admin123
# Search Filter — must include uid for OpenLDAP
AD_USER_SEARCH_FILTER=(&(objectClass=person)(|(sAMAccountName={username})(uid={username})))

# this is the base dn for the ldap server
# Base DN
AD_BASE_DN=dc=squ,dc=edu,dc=om
AD_USER_DN=ou=Users,dc=squ,dc=edu,dc=om
AD_GROUP_DN=ou=Groups,dc=squ,dc=edu,dc=om
AD_GROUP_SEARCH_FILTER=(objectClass=group)
AD_USER_ATTRIBUTES=sAMAccountName,uid,cn,displayName,givenName,sn,mail,userPrincipalName,memberOf,accountExpires,userAccountControl,lastLogon,employeeID,department,title,telephoneNumber,objectClass
AD_PROTOCOL_VERSION=3
AD_CONNECTION_TIMEOUT=30
AD_SEARCH_TIMEOUT=60
AD_MAX_CONNECTIONS=10
AD_VERIFY_SSL=false
AD_SYNC_INTERVAL_HOURS=24
AD_SYNC_BATCH_SIZE=100
AD_ENABLE_AUTO_SYNC=true
AD_CHECK_ACCOUNT_STATUS=true
AD_DEACTIVATE_EXPIRED_ACCOUNTS=true
AD_DEACTIVATE_DISABLED_ACCOUNTS=true
AD_DEFAULT_INTERNAL_ROLE=student
AD_DEFAULT_EXTERNAL_ROLE=external
AD_FOLLOW_REFERRALS=false
JWT_EXPIRY_HOURS=8
